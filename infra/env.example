# Copy OUTSIDE Git and set private values. Do not put an API key into frontend VITE_*.
FORTRESS_API_KEY=
POSTGRES_PASSWORD=
# URL-encode the password; DB hostname is the private Compose service postgres.
DATABASE_URL=
# Absolute private folder containing fullchain.pem and privkey.pem, not tracked.
FORTRESS_TLS_DIR=
# Local-only is the default. Changing the bind does not prove external reachability.
FORTRESS_BIND_IP=127.0.0.1
FORTRESS_HTTPS_PORT=8443
