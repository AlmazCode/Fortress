{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortress.invalid/contracts/v1/objects.schema.json",
  "title": "Fortress objects v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "frame_id": {
            "type": "string",
            "minLength": 1
          },
          "video_id": {
            "type": "string",
            "minLength": 1
          },
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "time": {
            "$ref": "https://fortress.invalid/contracts/v1/events.schema.json#/$defs/TimeMapping"
          },
          "objects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "object_id": {
                  "type": "string",
                  "minLength": 1
                },
                "class_id": {
                  "type": "string",
                  "minLength": 1
                },
                "bbox": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  ],
                  "items": false,
                  "minItems": 4,
                  "maxItems": 4
                },
                "visibility": {
                  "enum": [
                    "visible",
                    "partial",
                    "occluded",
                    "unknown"
                  ]
                },
                "review_status": {
                  "enum": [
                    "unreviewed",
                    "reviewed"
                  ]
                },
                "reviewer": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "actor_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "object_id",
                "class_id",
                "bbox",
                "visibility",
                "review_status",
                "reviewer",
                "actor_id"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "review_status": {
                        "const": "reviewed"
                      }
                    },
                    "required": [
                      "review_status"
                    ]
                  },
                  "then": {
                    "properties": {
                      "reviewer": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              ]
            }
          },
          "provenance": {
            "$ref": "https://fortress.invalid/contracts/v1/events.schema.json#/$defs/Provenance"
          }
        },
        "required": [
          "frame_id",
          "video_id",
          "scene_id",
          "width",
          "height",
          "sha256",
          "time",
          "objects",
          "provenance"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "dataset_version",
    "taxonomy_version",
    "frames"
  ],
  "additionalProperties": false
}
