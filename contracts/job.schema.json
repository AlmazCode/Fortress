{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortress.invalid/contracts/v1/job.schema.json",
  "title": "Fortress job v1",
  "oneOf": [
    {
      "$ref": "#/$defs/Processing"
    },
    {
      "$ref": "#/$defs/Done"
    },
    {
      "$ref": "#/$defs/Failed"
    }
  ],
  "$defs": {
    "Processing": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "const": "processing"
        }
      },
      "required": [
        "job_id",
        "status"
      ],
      "additionalProperties": false
    },
    "Done": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "const": "done"
        },
        "verdict": {
          "enum": [
            "violation",
            "no_violation"
          ]
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "timecode_sec": {
                "type": "number",
                "minimum": 0
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "evidence_frames": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "timestamp_sec": {
                      "type": "number",
                      "minimum": 0
                    },
                    "image_base64": {
                      "type": "string",
                      "minLength": 16,
                      "maxLength": 8388608,
                      "pattern": "^/9j/[A-Za-z0-9+/]*={0,2}$"
                    }
                  },
                  "required": [
                    "timestamp_sec",
                    "image_base64"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 3
              }
            },
            "required": [
              "type",
              "timecode_sec",
              "description",
              "evidence_frames"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "job_id",
        "status",
        "verdict",
        "violations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "violation"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "violations": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verdict": {
                "const": "no_violation"
              }
            },
            "required": [
              "verdict"
            ]
          },
          "then": {
            "properties": {
              "violations": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "Failed": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "const": "failed"
        },
        "reason": {
          "enum": [
            "insufficient_evidence",
            "deadline_exceeded",
            "decode_failed",
            "inference_failed",
            "evidence_failed",
            "worker_lost",
            "internal_error",
            "release_invalid"
          ]
        }
      },
      "required": [
        "job_id",
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "EvidenceFrame": {
      "type": "object",
      "properties": {
        "timestamp_sec": {
          "type": "number",
          "minimum": 0
        },
        "image_base64": {
          "type": "string",
          "minLength": 16,
          "maxLength": 8388608,
          "pattern": "^/9j/[A-Za-z0-9+/]*={0,2}$"
        }
      },
      "required": [
        "timestamp_sec",
        "image_base64"
      ],
      "additionalProperties": false
    },
    "Violation": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "timecode_sec": {
          "type": "number",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence_frames": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "timestamp_sec": {
                "type": "number",
                "minimum": 0
              },
              "image_base64": {
                "type": "string",
                "minLength": 16,
                "maxLength": 8388608,
                "pattern": "^/9j/[A-Za-z0-9+/]*={0,2}$"
              }
            },
            "required": [
              "timestamp_sec",
              "image_base64"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 3
        }
      },
      "required": [
        "type",
        "timecode_sec",
        "description",
        "evidence_frames"
      ],
      "additionalProperties": false
    },
    "Accepted": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "job_id"
      ],
      "additionalProperties": false
    }
  }
}
