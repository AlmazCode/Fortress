{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortress.invalid/contracts/v1/diagnostics.schema.json",
  "title": "Fortress diagnostics v1",
  "oneOf": [
    {
      "$ref": "#/$defs/Job"
    },
    {
      "$ref": "#/$defs/Model"
    },
    {
      "$ref": "#/$defs/Error"
    }
  ],
  "$defs": {
    "Job": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "job_id": {
          "type": "string",
          "format": "uuid"
        },
        "public": {
          "$ref": "https://fortress.invalid/contracts/v1/job.schema.json"
        },
        "stage": {
          "enum": [
            "validation",
            "queued",
            "decoding",
            "inference",
            "rules",
            "evidence",
            "done",
            "failed"
          ]
        },
        "processed_sec": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_sec": {
          "type": "number",
          "minimum": 0
        },
        "coverage": {
          "enum": [
            "full",
            "partial",
            "none"
          ]
        },
        "unknown": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "versions": {
          "type": "object",
          "properties": {
            "dataset": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "annotations": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "split": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "rules": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "model": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "preprocessing": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "taxonomy": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "dataset",
            "annotations",
            "split",
            "rules",
            "model",
            "preprocessing",
            "taxonomy"
          ],
          "additionalProperties": false
        },
        "timeline": {
          "anyOf": [
            {
              "$ref": "https://fortress.invalid/contracts/v1/events.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "media": {
          "type": "object",
          "properties": {
            "original": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "pattern": "^/api/ui/v1/jobs/[a-f0-9-]+/(?:media|preview|frames/[A-Za-z0-9_-]+)$"
                    },
                    "content_type": {
                      "enum": [
                        "video/mp4",
                        "video/quicktime",
                        "image/jpeg"
                      ]
                    },
                    "max_bytes": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 209715200
                    }
                  },
                  "required": [
                    "url",
                    "content_type",
                    "max_bytes"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "preview": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "pattern": "^/api/ui/v1/jobs/[a-f0-9-]+/(?:media|preview|frames/[A-Za-z0-9_-]+)$"
                    },
                    "content_type": {
                      "enum": [
                        "video/mp4",
                        "video/quicktime",
                        "image/jpeg"
                      ]
                    },
                    "max_bytes": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 209715200
                    }
                  },
                  "required": [
                    "url",
                    "content_type",
                    "max_bytes"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "original",
            "preview"
          ],
          "additionalProperties": false
        },
        "provenance": {
          "$ref": "https://fortress.invalid/contracts/v1/events.schema.json#/$defs/Provenance"
        }
      },
      "required": [
        "schema_version",
        "job_id",
        "public",
        "stage",
        "processed_sec",
        "duration_sec",
        "coverage",
        "unknown",
        "unsupported",
        "limitations",
        "versions",
        "timeline",
        "media",
        "provenance"
      ],
      "additionalProperties": false
    },
    "Model": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "status": {
          "enum": [
            "ready",
            "not_ready"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "release_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "trained": {
          "type": "boolean"
        },
        "validated": {
          "type": "boolean"
        },
        "test_only": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schema_version",
        "status",
        "reason",
        "release_version",
        "trained",
        "validated",
        "test_only",
        "limitations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ready"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "trained": {
                "const": true
              },
              "validated": {
                "const": true
              },
              "test_only": {
                "const": false
              },
              "release_version": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "invalid_request",
                "invalid_key",
                "job_not_found",
                "media_not_found",
                "upload_too_large",
                "unsupported_media",
                "capacity_exceeded",
                "model_not_ready",
                "service_unavailable"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                400,
                401,
                404,
                413,
                415,
                429,
                503
              ]
            }
          },
          "required": [
            "code",
            "message",
            "status"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "invalid_request"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "status": {
                    "const": 400
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "invalid_key"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "status": {
                    "const": 401
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "job_not_found"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "status": {
                    "const": 404
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "media_not_found"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "status": {
                    "const": 404
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "upload_too_large"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "status": {
                    "const": 413
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "unsupported_media"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "status": {
                    "const": 415
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "capacity_exceeded"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "status": {
                    "const": 429
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "model_not_ready"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "status": {
                    "const": 503
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "code": {
                    "const": "service_unavailable"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "status": {
                    "const": 503
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  }
}
