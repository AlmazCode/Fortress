{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fortress.invalid/contracts/v1/dataset_readiness.schema.json",
  "title": "Fortress dataset_readiness v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "draft",
        "ready",
        "blocked"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "unknown"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "status",
          "detail"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "$ref": "https://fortress.invalid/contracts/v1/events.schema.json#/$defs/Provenance"
    }
  },
  "required": [
    "schema_version",
    "dataset_version",
    "state",
    "checks",
    "limitations",
    "provenance"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "ready"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "const": "passed"
                }
              }
            }
          },
          "limitations": {
            "maxItems": 0
          },
          "provenance": {
            "properties": {
              "kind": {
                "const": "original"
              }
            }
          }
        }
      }
    }
  ]
}
